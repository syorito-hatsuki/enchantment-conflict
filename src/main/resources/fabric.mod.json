{
  "schemaVersion": 1,
  "id": "enchantment-conflict",
  "version": "${modVersion}",
  "name": "Enchantment Conflict",
  "description": "Research with enchantments conflicts",
  "authors": [
    "Syorito Hatsuki"
  ],
  "contact": {
    "homepage": "https://github.com/syorito-hatsuki/",
    "issues": "https://github.com/syorito-hatsuki/enchantment-conflict/issues",
    "sources": "https://github.com/syorito-hatsuki/enchantment-conflict"
  },
  "license": "MIT Licence",
  "icon": "assets/enchantment-conflict/icon.png",
  "accessWidener": "enchantment-conflict.accesswidener",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "dev.syoritohatsuki.enchantmentconflict.EnchantmentConflict"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.syoritohatsuki.enchantmentconflict.client.EnchantmentConflictClient"
      }
    ],
    "jei_mod_plugin": [
      {
        "adapter": "kotlin",
        "value": "dev.syoritohatsuki.enchantmentconflict.client.integration.jei.EnchantmentConflictJEIPlugin"
      }
    ]
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/pbwnMwnUD6"
      },
      "badges": [],
      "update_checker": true
    },
    "mcb": [
      {
        "name": "Ducky House",
        "fillColor": -13730510,
        "outlineColor": -11751600
      }
    ]
  },
  "mixins": [
    "enchantment-conflict.mixins.json"
  ],
  "depends": {
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "fabricloader": ">=${loaderVersion}",
    "java": "*",
    "minecraft": ">=${minecraftVersion}"
  },
  "recommends": {
    "modmenu-badges-lib": "*",
    "jei": "*"
  }
}